# Local Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5437
POSTGRES_DB=bio_appointment
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_password_123

# Redis Configuration (for sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_123

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-environment
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:5173/api

# DingTalk Configuration (optional)
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=

# Database Connection String (constructed from above)
DATABASE_URL=postgresql://app_user:secure_password_123@localhost:5437/bio_appointment

# PgAdmin Configuration (optional)
PGADMIN_ENABLED=false
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050