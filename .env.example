# Environment Configuration for Bio-Appointment

# Database Configuration
# Use Supabase (legacy) or Local PostgreSQL
DATABASE_TYPE=local
DATABASE_URL=postgresql://app_user:secure_password_123@localhost:5437/bio_appointment

# Local Database Configuration (when DATABASE_TYPE=local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5437
POSTGRES_DB=bio_appointment
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_password_123

# Supabase Configuration (legacy - for migration)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_123

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-environment
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5173/api

# DingTalk Configuration
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=

# Development Server
VITE_DEV_HOST=127.0.0.1